{
  "name": "calendar-sync",
  "productName": "Calendar Sync",
  "version": "0.1.1",
  "description": "Tray app that mirrors work calendars (ICS feeds) into a private Google Calendar as detail-free busy blocks.",
  "license": "MIT",
  "author": "Calendar Sync contributors",
  "main": "./out/main/index.js",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "@googleapis/calendar": "^20.1.0",
    "electron-updater": "^6.8.9",
    "google-auth-library": "^11.2.0",
    "ical.js": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:mac": "npm run build && electron-builder --mac --publish never",
    "build:linux": "npm run build && electron-builder --linux --publish never",
    "build:unpack": "npm run build && electron-builder --dir --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli/index.ts",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "electron-builder install-app-deps",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "calendar",
    "google-calendar",
    "outlook",
    "ics",
    "sync",
    "electron",
    "tray"
  ],
  "engines": {
    "node": ">=20"
  }
}
